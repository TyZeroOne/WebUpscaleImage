{
  "name": "image-enhancer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome MV3 extension that upscales images directly on the page, fully locally.",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@tensorflow/tfjs-layers": "^4.22.0",
    "@upscalerjs/esrgan-legacy": "^1.0.0",
    "@upscalerjs/esrgan-medium": "^1.0.0",
    "@upscalerjs/esrgan-slim": "^1.0.0"
  }
}
